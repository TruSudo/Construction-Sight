{
  "schema_version": 1,
  "controls": [
    {
      "id": "search",
      "selector": "#search",
      "behavior": "Global grouped search, keyboard selection, Enter opens dossier",
      "data_source": "SMARTS rows, contacts and persisted notes",
      "status": "Partial",
      "test": {
        "runner": "tests/ui/click_through.js",
        "action": "fill",
        "value": "Riverside",
        "expect": "#dossier h2",
        "text": "Riverside"
      }
    },
    {
      "id": "region",
